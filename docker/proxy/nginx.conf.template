# TLS termination for the KSeF Integration API.
# Rendered from this template at container start by entrypoint.sh.

# Plain HTTP redirects to HTTPS. The application container keeps publishing its
# own port on the host, so this only covers traffic that reaches the proxy.
server {
    listen 80;
    server_name ${KSEF_SSL_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${KSEF_SSL_DOMAIN};

    ssl_certificate     ${KSEF_SSL_CERT_DIR}/server.crt;
    ssl_certificate_key ${KSEF_SSL_CERT_DIR}/server.key;

    # TLS 1.2 is the primary target: it is what the integrating clients
    # negotiate. 1.3 stays enabled because a 1.2-only client simply falls back,
    # and nothing older than 1.2 is accepted. Pin to a single version with
    # KSEF_SSL_PROTOCOLS, e.g. "TLSv1.2".
    ssl_protocols             ${KSEF_SSL_PROTOCOLS};

    # This list applies to TLS 1.2 and below ONLY — TLS 1.3 suites are fixed by
    # OpenSSL and are not configured here. All entries provide forward secrecy;
    # the CBC-SHA suites at the end are kept for older Java/SAP stacks that do
    # not offer an AEAD suite. Override with KSEF_SSL_CIPHERS.
    ssl_ciphers               ${KSEF_SSL_CIPHERS};
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # The API accepts Base64 payloads (invoice XML, certificates), so the
    # default 1m would reject legitimate requests.
    client_max_body_size ${KSEF_SSL_MAX_BODY};

    # Docker's embedded DNS. Needed because the upstream is given as a variable
    # below, which defers name resolution to request time.
    resolver ${KSEF_SSL_RESOLVER} valid=10s ipv6=off;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    location / {
        # Resolved per request rather than once at startup: the application
        # container gets a new IP whenever it is recreated, and a hostname
        # written directly into proxy_pass would pin the proxy to the old one
        # until it was itself restarted.
        set $ksef_upstream ${KSEF_SSL_UPSTREAM};

        proxy_pass         http://$ksef_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # PDF generation shells out to Node.js and can take a while.
        proxy_connect_timeout 10s;
        proxy_send_timeout    ${KSEF_SSL_READ_TIMEOUT};
        proxy_read_timeout    ${KSEF_SSL_READ_TIMEOUT};

        proxy_buffering off;
    }
}
